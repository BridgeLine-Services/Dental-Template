// Prisma schema for Bright Smile Dental — production dental SaaS template
// Database: PostgreSQL (Supabase / Neon / Railway / AWS RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(PATIENT)
  image         String?
  emailVerified DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  lastLoginIp   String?

  patient       Patient?
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DENTIST
  HYGIENIST
  RECEPTIONIST
  PATIENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("refresh_tokens")
}

// ============ DENTAL PRACTICE DATA ============

model Patient {
  id                  String       @id @default(cuid())
  userId              String       @unique
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              String?
  address             String?
  city                String?
  state               String?
  zip                 String?
  phone               String?
  email               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceProvider     String?
  insuranceMemberId    String?
  insuranceGroupId    String?
  medicalHistory       String?     @db.Text
  allergies            String?
  medications          String?
  notes               String?     @db.Text
  status              PatientStatus @default(ACTIVE)
  isNewPatient        Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  treatments          Treatment[]
  forms               PatientForm[]
  messages            SecureMessage[]
  documents          PatientDocument[]
  reviews             Review[]
  consentRecords      ConsentRecord[]

  @@index([email])
  @@index([status])
  @@map("patients")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DECEASED
}

model Provider {
  id              String   @id @default(cuid())
  name            String
  title           String?
  bio             String?  @db.Text
  photo           String?
  education       String[] @default([])
  certifications  String[] @default([])
  expertise       String[] @default([])
  languages       String[] @default([])
  funFacts        String[] @default([])
  yearsExperience Int?
  rating          Float?
  reviewCount     Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  treatments      Treatment[]
  reviews         Review[]

  @@map("providers")
}

model Service {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  category         String?
  shortDescription String?
  description      String?  @db.Text
  procedure        String?  @db.Text
  benefits         String?  @db.Text
  recovery         String?  @db.Text
  duration         Int?
  price            Float?
  icon             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments     Appointment[]
  treatments       Treatment[]

  @@index([slug])
  @@map("services")
}

model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  providerId        String?
  serviceId        String?
  patientName      String
  patientEmail     String
  patientPhone     String
  dentistId        String?
  dentistName      String?
  serviceName      String
  serviceSlug      String?
  date             String
  time             String
  duration         Int               @default(30)
  serviceDuration  Int?
  status           AppointmentStatus @default(PENDING)
  insuranceProvider String?
  isNewPatient     Boolean           @default(false)
  notes            String?           @db.Text
  reminderSent     Boolean           @default(false)
  followUpSent     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider         Provider?         @relation(fields: [providerId], references: [id])
  service          Service?          @relation(fields: [serviceId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([date, time])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Treatment {
  id            String   @id @default(cuid())
  patientId     String
  providerId    String?
  serviceId     String?
  patientName   String
  providerName  String?
  serviceSlug   String?
  description   String?  @db.Text
  toothNumber   String?
  cost          Float?
  status        String   @default("planned")
  completedDate DateTime?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider      Provider? @relation(fields: [providerId], references: [id])
  service       Service?  @relation(fields: [serviceId], references: [id])

  @@index([patientId])
  @@map("treatments")
}

model Review {
  id         String   @id @default(cuid())
  author     String
  rating     Int
  text       String   @db.Text
  treatment  String?
  patientId  String?
  dentistId  String?
  status     ReviewStatus @default(PENDING)
  featured   Boolean  @default(false)
  googleReviewId String?
  googleReviewUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  patient    Patient? @relation(fields: [patientId], references: [id])
  provider   Provider? @relation(fields: [dentistId], references: [id])

  @@index([status])
  @@index([dentistId])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FEATURED
}

// ============ FORMS & CONSENT ============

model PatientForm {
  id            String   @id @default(cuid())
  patientId     String
  patientName   String
  formType      String
  formData      Json
  signature     String?  @db.Text
  status        String   @default("submitted")
  submittedDate DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([formType])
  @@map("patient_forms")
}

model ConsentRecord {
  id              String   @id @default(cuid())
  patientId       String
  consentType     String
  consentText     String   @db.Text
  signature       String   @db.Text
  ipAddress       String
  userAgent       String
  withdrawn       Boolean  @default(false)
  withdrawnAt     DateTime?
  consentedAt     DateTime @default(now())

  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([consentType])
  @@map("consent_records")
}

model PatientDocument {
  id          String   @id @default(cuid())
  patientId   String
  fileName    String
  fileType    String
  fileSize    Int
  fileUrl     String
  category    String   @default("general")
  uploadedAt  DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_documents")
}

// ============ COMMUNICATIONS ============

model SecureMessage {
  id         String   @id @default(cuid())
  patientId  String
  subject    String
  body       String   @db.Text
  fromRole   String   @default("patient")
  isRead     Boolean  @default(false)
  readAt     DateTime?
  createdAt  DateTime @default(now())

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("secure_messages")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("contact_messages")
}

// ============ COMPLIANCE & AUDIT ============

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String?
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model BreachLog {
  id            String   @id @default(cuid())
  severity      String
  description   String   @db.Text
  affectedRecords Int
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?
  resolution    String?  @db.Text
  reportedToHHS Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("breach_logs")
}

// ============ BUSINESS & MARKETING ============

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.Text
  author      String
  category    String?
  tags        String[] @default([])
  image       String?
  published   Boolean  @default(false)
  publishDate DateTime?
  readTime    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published, publishDate])
  @@map("blog_posts")
}

model SpecialOffer {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  details     String?  @db.Text
  badge       String?
  cta         String?
  endDate     DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("special_offers")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  beforeImage String?
  afterImage  String?
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

model FAQItem {
  id            String   @id @default(cuid())
  question      String
  answer        String   @db.Text
  category      String?
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("faq_items")
}

model InsurancePlan {
  id            String   @id @default(cuid())
  providerName  String
  planType      String?
  accepted      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([providerName])
  @@map("insurance_plans")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("website")
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String?
  currentStock  Int      @default(0)
  reorderLevel  Int      @default(10)
  unitCost     Float?
  unitOfMeasure String?
  supplier      String?
  lastRestocked DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("inventory_items")
}

// ============ MEMBERSHIP & REFERRALS ============

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  monthlyPrice Float
  annualPrice  Float?
  benefits     String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  enrollments MembershipEnrollment[]
  @@map("membership_plans")
}

model MembershipEnrollment {
  id          String   @id @default(cuid())
  patientId   String
  planId      String
  status      String   @default("active")
  enrolledAt  DateTime @default(now())
  canceledAt  DateTime?
  nextBillingDate DateTime?
  createdAt   DateTime @default(now())

  plan        MembershipPlan @relation(fields: [planId], references: [id])

  @@index([patientId])
  @@map("membership_enrollments")
}

model Referral {
  id              String   @id @default(cuid())
  referrerName     String
  referrerEmail    String
  referredName     String
  referredEmail    String
  status           String   @default("pending")
  rewardType       String?
  rewardValue      Float?
  redeemedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([referrerEmail])
  @@map("referrals")
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  patientName String
  email       String
  phone       String?
  serviceSlug String?
  preferredDate String?
  preferredTime String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([serviceSlug])
  @@map("waitlist_entries")
}

// ============ PAYMENTS ============

model Payment {
  id              String   @id @default(cuid())
  patientId       String?
  patientName     String
  amount          Float
  serviceName     String
  stripeSessionId String?
  stripePaymentId  String?
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  createdAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Invoice {
  id          String   @id @default(cuid())
  patientId   String?
  patientName String
  amount      Float
  taxAmount   Float    @default(0)
  totalAmount Float
  status      String   @default("open")
  dueDate     DateTime?
  paidDate    DateTime?
  lineItems   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@map("invoices")
}
